# streaming-insights box env (docker/.env). Values here are the deploy-tuned
# overrides referenced by the COMMITTED environment blocks in
# docker/docker-compose.yml. Copy to docker/.env on the .151 box and set the
# real public origins / TURN creds / model path.

# --- Postgres ---
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming

# --- control plane / webapp ---
CONTROL_PORT=3100
# Public origins (Cloudflare tunnel front) that the browser reaches.
PUBLIC_BASE_URL=https://si-control.example.com
MEDIA_PUBLIC_BASE_URL=https://si-media.example.com

# --- media (public origin + WebRTC ICE) ---
MEDIA_PORT=4070
RTC_SAMPLE_FPS=1
WINDOW_FRAMES=2
GATE_THRESHOLD=0.5
# STUN/TURN for WebRTC ingest. TURN is required for browsers behind symmetric
# NAT: the box's werift host/srflx candidates are LAN addresses, so the browser
# needs a relay candidate. The public tall relay is the shared coturn endpoint
# on livepeer-ai-x99 (public 136.33.135.223, UDP/3478, creds on the box at
# /root/.turn-creds). Embed creds as `turn:<user>:<pass>@host:port` — the media
# server splits them into the RTCIceServer username/credential fields.
RTC_ICE_SERVERS=stun:stun.l.google.com:19302

# --- media -> runner dispatch ---
# The `adapter` service exposes the /v1/mage/window contract on top of the real
# SGLang Mage-VL runner, so the deployed path runs on the GPU model. MOCK_RUNNER
# is an explicit opt-in for GPU-less environments only.
RUNNER_BASE_URL=http://adapter:4180
MOCK_RUNNER=false
# Adapter -> SGLang (OpenAI-compatible base of the box runner).
RUNNER_UPSTREAM=http://192.168.1.151:30000/v1
RUNNER_MODEL=microsoft/Mage-VL
RUNNER_MAX_TOKENS=128
RUNNER_TEMPERATURE=0
RUNNER_TIMEOUT_MS=60000
MAX_FRAMES_PER_WINDOW=2
DENSE_TOKENS_PER_FRAME=576

# --- runner (Mage-VL SGLang GPU) ---
RUNNER_PORT=30000
RUNNER_IMAGE=mage-vl-sglang:cu130
MODELS_DIR=/home/brad/mage_vl/models
MODEL_PATH=/models/microsoft/Mage-VL
CUDA_VISIBLE_DEVICES=0

# --- runner capacity ---
RUNNERS=3
STREAMS_PER_RUNNER=3
MAX_STREAMS=9
