# Control server environment (services/server)
# DATABASE_URL is required in production. In dev, if left unset, the server
# boots against an in-process PGlite database (see services/server/src/config.ts).
DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming

PORT=3100
NODE_ENV=development

# Runner capacity is a first-class constant (see plan: 3 runners x 3 streams).
RUNNERS=3
STREAMS_PER_RUNNER=3
MAX_STREAMS=9

# Runner heartbeat TTL (ms) after which a runner is marked down.
RUNNER_HEARTBEAT_TTL_MS=15000
# Slots are rebalanced when a runner is marked down and its sessions released.

# Media server environment (services/media). Own public origin, separate service.
MEDIA_PORT=4070
# Public origin the browser uses for the WebRTC RTC signaling + full WS ingest URL.
MEDIA_PUBLIC_BASE_URL=https://mage-media.example.com
# The control server base URL. When unset, the media server runs against an
# in-memory control client (isolated demos) and does not reserve runner slots.
CONTROL_BASE_URL=http://localhost:3100
# Real Mage-VL runner base URL (Phase 3). When unset the media server dispatches
# to the in-process mock runner so the ingest->window->event path runs with no GPU.
# RUNNER_BASE_URL=http://runner-0:8080
# Gate threshold used by the (mock) runner to decide silent vs speak.
GATE_THRESHOLD=0.5
