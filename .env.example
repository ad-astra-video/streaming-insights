# Control server environment (services/server)
# DATABASE_URL is required in production. In dev, if left unset, the server
# boots against an in-process PGlite database (see services/server/src/config.ts).
DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming

PORT=3100
NODE_ENV=development

# Runner capacity is a first-class constant (see plan: 3 runners x 3 streams).
RUNNERS=3
STREAMS_PER_RUNNER=3
MAX_STREAMS=9

# Runner heartbeat TTL (ms) after which a runner is marked down.
RUNNER_HEARTBEAT_TTL_MS=15000
# Slots are rebalanced when a runner is marked down and its sessions released.
